# ============================================================================
# Secretia — variables de entorno
# Copiá este archivo a `.env` y completá los valores. NUNCA commitees `.env`.
# ============================================================================

# URL pública de Secretia (la que configures en EasyPanel)
WEBUI_URL=https://secretia.go.websiteonline.org
WEBUI_NAME=Secretia

# Clave de sesión/cifrado de Open WebUI.
# Generá una cadena larga y aleatoria, p.ej.:  openssl rand -hex 32
WEBUI_SECRET_KEY=cambiame-por-una-cadena-larga-y-aleatoria

# Alta de usuarios local. Dejala en false: las altas entran por Lockatus.
ENABLE_SIGNUP=false

# ── Federación con Lockatus (OIDC) ──────────────────────────────────────────
# Permite que un usuario nuevo (validado por Lockatus) se cree solo al entrar.
ENABLE_OAUTH_SIGNUP=true

# Texto del botón de login ("Continuar con Lockatus")
OAUTH_PROVIDER_NAME=Lockatus

# client_id / client_secret REGISTRADOS en Lockatus para la app `secretia`.
# (Lockatus es cliente público PKCE; igual registrá la app y, si tu Lockatus
#  exige secret, poné el mismo acá. Ver README → "Federar con Lockatus".)
OAUTH_CLIENT_ID=secretia
OAUTH_CLIENT_SECRET=cambiame-igual-al-registrado-en-lockatus

# Discovery de Lockatus (no la cambies salvo que muevas el issuer)
OPENID_PROVIDER_URL=https://lockatus.go.websiteonline.org/.well-known/openid-configuration

# Redirect que Open WebUI usa para OIDC. Esta MISMA URL hay que registrarla
# en Lockatus como redirect_uri de la app `secretia`.
OPENID_REDIRECT_URI=https://secretia.go.websiteonline.org/oauth/oidc/callback

OAUTH_SCOPES=openid email profile

# Si un mail ya existe como usuario local, lo fusiona con el de Lockatus.
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true
