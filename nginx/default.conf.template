# Secretia — capa pública de branding sobre Open WebUI.
# Proxy a Open WebUI + inyección del CSS de marca + assets estáticos.
#
# La imagen oficial de nginx procesa esta plantilla con envsubst al arrancar,
# reemplazando SOLO ${OPEN_WEBUI_UPSTREAM} (por NGINX_ENVSUBST_FILTER).
# Las demás $variables son de nginx y quedan intactas.

# Header Connection para websockets (chat en tiempo real).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Conserva el https que termina el ingress de EasyPanel/Traefik; si no viene,
# usa el esquema local. Open WebUI lo necesita para armar bien los redirects OIDC.
map $http_x_forwarded_proto $secretia_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen 8080;
    server_name _;

    client_max_body_size 100m;

    # Assets estáticos de Secretia (CSS, logo, favicon, fuente).
    location /secretia/ {
        alias /usr/share/nginx/secretia/;
        access_log off;
        expires 7d;
    }

    # ── Logo de Secretia sobre los assets de Open WebUI ───────────────────────
    # Servimos nuestro SVG en las rutas que Open WebUI usa para su logo/favicon/
    # splash. El <img> del front renderiza por content-type (image/svg+xml), así
    # que el logo "OI" pasa a ser el de Secretia sin tocar el código de OWUI.
    location = /favicon.ico                            { alias /usr/share/nginx/secretia/logo.svg; access_log off; }
    location = /static/favicon.png                     { alias /usr/share/nginx/secretia/logo.svg; access_log off; }
    location = /static/favicon-96x96.png               { alias /usr/share/nginx/secretia/logo.svg; access_log off; }
    location = /static/favicon.svg                     { alias /usr/share/nginx/secretia/logo.svg; access_log off; }
    location = /static/favicon.ico                     { alias /usr/share/nginx/secretia/logo.svg; access_log off; }
    location = /static/apple-touch-icon.png            { alias /usr/share/nginx/secretia/logo.svg; access_log off; }
    location = /static/splash.png                      { alias /usr/share/nginx/secretia/logo.svg; access_log off; }
    location = /static/splash-dark.png                 { alias /usr/share/nginx/secretia/logo.svg; access_log off; }
    location = /static/web-app-manifest-192x192.png    { alias /usr/share/nginx/secretia/logo.svg; access_log off; }
    location = /static/web-app-manifest-512x512.png    { alias /usr/share/nginx/secretia/logo.svg; access_log off; }

    # ── Página de Modelos (servicio Node interno; descarga modelos de Ollama) ──
    # El servicio `models` es OPCIONAL. Usamos el resolver interno de Docker +
    # un upstream por variable para que nginx NO falle al arrancar si `models`
    # no existe: en ese caso /modelos da 502, pero el chat sigue andando.
    location = /modelos { return 301 /modelos/; }
    location /modelos/ {
        resolver 127.0.0.11 ipv6=off valid=30s;
        set $models_upstream ${MODELS_UPSTREAM};
        rewrite ^/modelos/(.*)$ /$1 break;   # descarta el prefijo /modelos/
        proxy_pass http://$models_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $secretia_proto;
        proxy_read_timeout 1800s;   # descargas de modelos largas
        proxy_buffering   off;      # progreso de descarga en vivo (ndjson streaming)
    }

    # Todo lo demás: proxy a Open WebUI.
    location / {
        proxy_pass http://${OPEN_WEBUI_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $secretia_proto;

        # Websockets
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;

        # sub_filter no funciona sobre gzip → pedimos el HTML sin comprimir.
        proxy_set_header Accept-Encoding "";

        # Inyecta el CSS de Secretia antes de cerrar el <head>.
        sub_filter '</head>' '<link rel="stylesheet" href="/secretia/secretia.css"></head>';
        sub_filter_once  on;
        sub_filter_types text/html;
    }
}
